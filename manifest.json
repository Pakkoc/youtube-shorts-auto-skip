{
  "manifest_version": 3,
  "name": "YouTube Shorts Auto Skip",
  "version": "1.1.1",
  "description": "YouTube Shorts 영상이 끝나면 자동으로 다음 Shorts로 이동합니다.",
  "icons": {
    "16": "img/icon.png",
    "48": "img/icon.png",
    "128": "img/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
